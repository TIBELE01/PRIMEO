# =============================================================================
# PRIMEO — Variables d'environnement pour les tests
# Utilisé par Jest (tests unitaires et d'intégration).
# Base de données PostgreSQL isolée, clés factices non fonctionnelles.
# =============================================================================

NODE_ENV=test
PORT=3001
BACKEND_URL=http://localhost:3001
FRONTEND_URL=primeo://
LEGAL_SITE_URL=http://localhost:3002
ADMIN_URL=http://localhost:3003

# Base de données de test (Docker local — base dédiée primeo_test)
DATABASE_URL=postgresql://primeo:primeo_dev@localhost:5432/primeo_test

# JWT — clés factices pour les tests (non utilisées en production)
JWT_SECRET=test-jwt-secret-key-for-testing-only-minimum-64-characters-long-fake
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# Genius Pay — clés factices (les webhooks sont mockés dans les tests)
GENIUS_PAY_API_KEY=gp_test_fake_api_key_for_testing
GENIUS_PAY_SECRET_KEY=gp_test_fake_secret_key_for_testing
GENIUS_PAY_WEBHOOK_SECRET=gp_test_fake_webhook_secret_for_testing
GENIUS_PAY_BASE_URL=http://localhost:9090

# Brevo — désactivé en tests (emails mockés)
BREVO_API_KEY=xkeysib-test-fake-api-key-for-testing-only
BREVO_SENDER_EMAIL=test@primeo.ci
BREVO_SENDER_NAME=Primeo Test

# OneSignal — désactivé en tests (push mockés)
ONESIGNAL_APP_ID=00000000-0000-0000-0000-000000000000
ONESIGNAL_API_KEY=os_v2_app_test_fake_key_for_testing_only

# Orange SMS — désactivé en tests (SMS mockés)
ORANGE_SMS_CLIENT_ID=test_fake_client_id
ORANGE_SMS_CLIENT_SECRET=test_fake_client_secret
ORANGE_SMS_SENDER_NAME=PRIMEO_TEST

# Cloudinary — désactivé en tests (uploads mockés)
CLOUDINARY_CLOUD_NAME=primeo-test
CLOUDINARY_API_KEY=000000000000001
CLOUDINARY_API_SECRET=test_fake_cloudinary_secret

# Geoapify — désactivé en tests (géoloc mockée)
GEOAPIFY_API_KEY=test_fake_geoapify_key

# Upstash Redis — non utilisé en tests (rate limiting désactivé)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Monitoring — désactivé en tests
SENTRY_DSN=
LOGTAIL_TOKEN=

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# =============================================================================
# PRIMEO — Variables d'environnement Production
# À renseigner avec les vraies valeurs de production.
# Ce fichier est un template — les valeurs sont vides.
# Les vraies valeurs sont injectées via les variables d'environnement Render.
# =============================================================================

NODE_ENV=production
PORT=3000
BACKEND_URL=
FRONTEND_URL=primeo://
LEGAL_SITE_URL=https://legal.primeo.ci
ADMIN_URL=https://admin.primeo.ci

# Base de données (Supabase — projet production)
DATABASE_URL=

# Genius Pay
GENIUS_PAY_API_KEY=
GENIUS_PAY_SECRET_KEY=
GENIUS_PAY_WEBHOOK_SECRET=
GENIUS_PAY_BASE_URL=https://api.genius.ci

# Brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=notifications@primeo.ci
BREVO_SENDER_NAME=Primeo

# OneSignal
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# Orange SMS
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER_NAME=PRIMEO

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Geoapify
GEOAPIFY_API_KEY=

# Upstash Redis (obligatoire en production multi-instances)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Monitoring
SENTRY_DSN=
LOGTAIL_TOKEN=

CORS_ORIGINS=https://admin.primeo.ci

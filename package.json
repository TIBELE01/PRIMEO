{
  "name": "primeo",
  "version": "1.0.0",
  "private": true,
  "description": "Plateforme unifiée de réservation d'hébergements, biens immobiliers et tables de restaurant en Côte d'Ivoire",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev:backend": "pnpm --filter backend dev",
    "dev:admin": "pnpm --filter admin dev",
    "build:backend": "pnpm --filter backend build",
    "build:admin": "pnpm --filter admin build",
    "start:backend": "pnpm --filter backend start",
    "start:admin": "pnpm --filter admin start",
    "test:backend": "pnpm --filter backend test",
    "test:backend:coverage": "pnpm --filter backend test:coverage",
    "test:backend:e2e": "pnpm --filter backend test:e2e",
    "lint": "pnpm --recursive lint",
    "lint:fix": "pnpm --recursive lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "db:generate": "pnpm --filter backend prisma:generate",
    "db:migrate": "pnpm --filter backend prisma:migrate",
    "db:migrate:prod": "pnpm --filter backend prisma:migrate:prod",
    "db:seed": "pnpm --filter backend prisma:seed",
    "db:studio": "pnpm --filter backend prisma:studio",
    "db:reset": "pnpm --filter backend prisma:reset",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@types/react": "19.1.17",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@9.1.0"
}

{
  "name": "primeo-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "jest --coverage",
    "test:components": "jest --config jest.config.components.js",
    "test:all": "npm test && npm run test:components",
    "test:watch": "jest --watch",
    "start": "cross-env EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start",
    "android": "cross-env EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start --android",
    "ios": "cross-env EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start --ios",
    "web": "cross-env EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start --web",
    "build:web": "cross-env EXPO_NO_METRO_WORKSPACE_ROOT=1 expo export --platform web",
    "build:dev": "eas build --profile development",
    "build:staging": "eas build --profile staging",
    "build:prod": "eas build --profile production",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "e2e:prebuild": "expo prebuild --platform android --no-install",
    "e2e:build:android": "detox build --configuration android.emu.debug",
    "e2e:test:android": "detox test --configuration android.emu.debug --cleanup"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@lottiefiles/dotlottie-react": "^0.19.4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@react-navigation/stack": "^6.4.1",
    "@react-three/fiber": "^9.6.0",
    "@sentry/react-native": "~7.2.0",
    "axios": "^1.7.2",
    "expo": "~54.0.35",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.12",
    "expo-gl": "~16.0.10",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-media-library": "~18.2.1",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.11",
    "i18next": "^23.7.6",
    "lottie-react-native": "~7.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^14.0.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "~0.5.1",
    "socket.io-client": "^4.7.5",
    "three": "^0.168.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.3",
    "@react-native/jest-preset": "^0.85.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "@types/three": "^0.168.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "cross-env": "^7.0.3",
    "detox": "^20.27.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "19.1.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/__tests__/components/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(\\.pnpm/[^/]+/node_modules/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|@sentry/.*|native-base|react-native-svg))"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.spec.{ts,tsx}",
      "!src/**/index.{ts,tsx}"
    ],
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "statements": 0.5,
        "branches": 0.3,
        "functions": 0,
        "lines": 0.5
      },
      "./src/screens/auth/auth.utils.ts": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      },
      "./src/utils/normalizeProperty.ts": {
        "statements": 45,
        "branches": 50,
        "functions": 55,
        "lines": 45
      },
      "./src/utils/safeJson.ts": {
        "statements": 80,
        "branches": 80,
        "functions": 100,
        "lines": 78
      }
    },
    "setupFiles": [
      "<rootDir>/__tests__/setup.ts"
    ]
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "enabled": false
      }
    }
  }
}

{
  "name": "primeo-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "jest --coverage",
    "test:components": "jest --config jest.config.components.js",
    "test:all": "npm test && npm run test:components",
    "test:watch": "jest --watch",
    "start": "EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start",
    "android": "EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start --android",
    "ios": "EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start --ios",
    "web": "EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start --web",
    "build:web": "expo export --platform web",
    "build:dev": "eas build --profile development",
    "build:staging": "eas build --profile staging",
    "build:prod": "eas build --profile production",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "e2e:prebuild": "expo prebuild --platform android --no-install",
    "e2e:build:android": "detox build --configuration android.emu.debug",
    "e2e:test:android": "detox test --configuration android.emu.debug --cleanup"
  },
  "dependencies": {
    "@expo/metro-runtime": "^4.0.1",
    "@lottiefiles/dotlottie-react": "^0.19.4",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@react-navigation/stack": "^6.4.1",
    "@react-three/fiber": "^8.17.1",
    "axios": "^1.7.2",
    "expo": "~52.0.0",
    "expo-build-properties": "~0.13.1",
    "expo-camera": "~16.0.10",
    "expo-constants": "~17.0.3",
    "expo-document-picker": "~13.0.1",
    "expo-font": "~13.0.1",
    "expo-gl": "~14.0.2",
    "expo-linking": "~7.0.3",
    "expo-web-browser": "~14.0.2",
    "expo-localization": "~16.0.1",
    "expo-location": "~18.0.4",
    "expo-media-library": "~17.0.4",
    "expo-notifications": "~0.29.9",
    "expo-secure-store": "~14.0.1",
    "expo-splash-screen": "~0.29.13",
    "expo-status-bar": "~2.0.0",
    "expo-video": "~2.0.1",
    "i18next": "^23.7.6",
    "lottie-react-native": "7.1.0",
    "react": "18.3.0",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.0.0",
    "react-native": "0.76.5",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-maps": "1.18.0",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13",
    "react-native-webview": "13.12.5",
    "socket.io-client": "^4.7.5",
    "three": "^0.168.0",
    "zustand": "^5.0.1",
    "@sentry/react-native": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "detox": "^20.27.0",
    "@react-native/jest-preset": "^0.85.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~18.3.12",
    "@types/react-native": "^0.73.0",
    "@types/three": "^0.168.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^29.7.0",
    "jest-expo": "^52.0.6",
    "react-test-renderer": "18.3.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/__tests__/components/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(\\.pnpm/[^/]+/node_modules/)?((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|@sentry/.*|native-base|react-native-svg))"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.spec.{ts,tsx}",
      "!src/**/index.{ts,tsx}"
    ],
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "statements": 0.5,
        "branches": 0.3,
        "functions": 0,
        "lines": 0.5
      },
      "./src/screens/auth/auth.utils.ts": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      },
      "./src/utils/normalizeProperty.ts": {
        "statements": 45,
        "branches": 50,
        "functions": 55,
        "lines": 45
      },
      "./src/utils/safeJson.ts": {
        "statements": 80,
        "branches": 80,
        "functions": 100,
        "lines": 78
      }
    },
    "setupFiles": [
      "<rootDir>/__tests__/setup.ts"
    ]
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "enabled": false
      }
    }
  }
}

# Variables d'environnement mobile (Expo) — copier en `.env` et compléter.
# Toutes les variables EXPO_PUBLIC_* sont embarquées dans le bundle (publiques).

EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_API_URL=https://<backend>.onrender.com
EXPO_PUBLIC_ONESIGNAL_APP_ID=<onesignal-app-id>

# Identifiant du projet EAS (https://expo.dev → projet → Project ID).
# Requis pour les builds EAS et l'enregistrement des tokens push
# (getExpoPushTokenAsync). Créer le projet : `npx eas init`.
EAS_PROJECT_ID=

# Sentry — error tracking mobile (React Native project, distinct du backend)
# Créer un projet React Native sur https://sentry.io et copier le DSN.
# Laissez vide pour désactiver (les erreurs ne seront pas remontées).
EXPO_PUBLIC_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/ZZZZ

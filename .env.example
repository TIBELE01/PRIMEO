# =============================================================================
# PRIMEO — Variables d'environnement
# Copier ce fichier vers backend/.env et renseigner les vraies valeurs.
# NE JAMAIS committer le fichier .env avec de vraies clés.
# =============================================================================

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
BACKEND_URL=https://api.primeo.ci
FRONTEND_URL=primeo://
LEGAL_SITE_URL=https://legal.primeo.ci
ADMIN_URL=https://admin.primeo.ci

# ─── Base de données (Supabase PostgreSQL) ────────────────────────────────────
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:your-supabase-password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# ─── Genius Pay (paiements) ───────────────────────────────────────────────────
# Documentation : https://pay.genius.ci/docs/api
GENIUS_PAY_API_KEY=gp_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GENIUS_PAY_SECRET_KEY=gp_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GENIUS_PAY_WEBHOOK_SECRET=gp_webhook_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GENIUS_PAY_BASE_URL=https://api.genius.ci

# ─── Brevo (emails transactionnels) ───────────────────────────────────────────
# Dashboard : https://app.brevo.com
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxx
BREVO_SENDER_EMAIL=notifications@primeo.ci
BREVO_SENDER_NAME=Primeo

# ─── OneSignal (notifications push iOS + Android) ────────────────────────────
# Dashboard : https://app.onesignal.com
ONESIGNAL_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ONESIGNAL_API_KEY=os_v2_app_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Secret partagé pour valider la signature HMAC des webhooks OneSignal entrants.
# Générer avec : openssl rand -hex 32
# Configurer la même valeur dans le dashboard OneSignal → Webhooks → Headers → X-OneSignal-Signature
ONESIGNAL_WEBHOOK_SECRET=your_onesignal_webhook_secret_hex_32_chars

# ─── Orange SMS API (SMS OTP Côte d'Ivoire) ───────────────────────────────────
# Dashboard : https://developer.orange.com
ORANGE_SMS_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ORANGE_SMS_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ORANGE_SMS_SENDER_NAME=PRIMEO

# ─── Cloudinary (images et médias) ────────────────────────────────────────────
# Dashboard : https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=primeo
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Geoapify (cartes, géolocalisation, autocomplétion) ──────────────────────
# Dashboard : https://myprojects.geoapify.com
GEOAPIFY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Upstash Redis (rate limiting + Socket.io multi-instances) ───────────────
# Dashboard : https://console.upstash.com — OPTIONNEL en dev mono-instance
UPSTASH_REDIS_REST_URL=https://xxxxx-xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Monitoring (optionnels) ──────────────────────────────────────────────────
# Sentry : https://sentry.io
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@oxxxxxxx.ingest.sentry.io/xxxxxxxxx
# Logtail : https://logtail.com
LOGTAIL_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Origines autorisées séparées par des virgules
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://admin.primeo.ci

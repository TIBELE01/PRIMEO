# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=production          # development | test | staging | production
PORT=4000
PUBLIC_URL=https://api.primeo.ci
BACKEND_URL=https://api.primeo.ci
FRONTEND_URL=https://app.primeo.ci

# ─── Database (Supabase PostgreSQL) ───────────────────────────────────────────
# Pooler URL (pgbouncer) — used at runtime
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct URL — used only by `prisma migrate` (not at runtime)
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# ─── Supabase Auth ────────────────────────────────────────────────────────────
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Admin seed (optional — dev/staging only) ─────────────────────────────────
ADMIN_PASSWORD=ChangeMe!
ALLOW_DEV_ADMIN_SEED=false

# ─── Cookies ──────────────────────────────────────────────────────────────────
COOKIE_SECURE=true
COOKIE_SAMESITE=none
COOKIE_DOMAIN=.primeo.ci

# ─── Norasend (WhatsApp Business + Telegram — envois et diffusions admin) ─────
# Clé d'API du compte Norasend. Sans elle, la section « Communication » du dashboard
# admin affiche les canaux comme non configurés.
NORASEND_API_KEY=
NORASEND_API_URL=https://api.norasend.com
# Schéma d'authentification : bearer (Authorization: Bearer <clé>) ou x-api-key (X-Api-Key)
NORASEND_AUTH_SCHEME=bearer
# Le numéro WhatsApp (QR code) et le bot Telegram se connectent depuis le tableau de bord
# Norasend : aucun identifiant de session ni de bot n'est nécessaire côté Primeo.

# ─── Proxy / rate limiting ────────────────────────────────────────────────────
# Nombre de proxys de confiance devant l'API (clé du rate limiting = req.ip).
# 1 sur Render. Vérifier après déploiement : GET /api/admin/client-ip doit
# renvoyer votre IP publique ; sinon augmenter la valeur d'une unité.
TRUST_PROXY=1

# ─── Maintenance mode ─────────────────────────────────────────────────────────
MAINTENANCE_MODE=false       # set to "true" to serve 503 + maintenance page

# ─── OTP bypass (never enable in production) ──────────────────────────────────
SKIP_OTP_VERIFICATION=false

# ─── Genius Pay (payments) ────────────────────────────────────────────────────
GENIUS_PAY_API_URL=https://api.geniuspay.ci
GENIUS_PAY_API_KEY=gp_live_...
GENIUS_PAY_SECRET_API_KEY=gp_secret_...
GENIUS_PAY_WEBHOOK_SECRET=whsec_...

# ─── Brevo (transactional email + SMTP) ───────────────────────────────────────
BREVO_API_KEY=xkeysib-...
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your@email.com
BREVO_SMTP_PASS=your-smtp-key
BREVO_WEBHOOK_SECRET=whsec_...

# ─── OneSignal (push notifications) ──────────────────────────────────────────
ONESIGNAL_APP_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ONESIGNAL_REST_API_KEY=os_...
ONESIGNAL_WEBHOOK_SECRET=whsec_...

# ─── Orange SMS (OTP — Côte d'Ivoire) ─────────────────────────────────────────
ORANGE_CLIENT_ID=your-client-id
ORANGE_CLIENT_SECRET=your-client-secret
ORANGE_SENDER=PRIMEO
ORANGE_WEBHOOK_SECRET=whsec_...

# ─── Cloudinary (media storage) ───────────────────────────────────────────────
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ─── Geoapify (maps / geocoding) ──────────────────────────────────────────────
GEOAPIFY_API_KEY=your-key
GEOAPIFY_URL=https://api.geoapify.com

# ─── Upstash Redis (rate limiting, caching) ───────────────────────────────────
UPSTASH_REDIS_REST_URL=https://[id].upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...
# Limite globale de requêtes par minute et par IP (défaut 300 ; auth : 5 échecs / 15 min, non modifiable)
RATE_LIMIT_GLOBAL_MAX=300
REDIS_URL=redis://...              # optional — ioredis direct URL (Socket.io adapter)
SOCKET_IO_REDIS_ENABLED=false      # set to "true" on multi-instance deployments

# ─── Exchange rates ────────────────────────────────────────────────────────────
EXCHANGERATE_API_KEY=your-key
EXCHANGERATE_BASE_CURRENCY=XOF

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://primeo.ci,https://www.primeo.ci,https://app.primeo.ci,*.onrender.com

# ─── Monitoring ───────────────────────────────────────────────────────────────

# Sentry — backend error tracking (https://sentry.io)
# Create a Node.js project in Sentry and copy the DSN here.
SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/YYYY

# Logtail / Better Stack — centralised structured logs (https://betterstack.com)
# Create a "Source" (Node.js) in Better Stack Logs and copy the source token here.
LOGTAIL_SOURCE_TOKEN=your-logtail-source-token

# Slack — ops alerts (high error rate, service outage)
# Create an Incoming Webhook in your Slack workspace and paste the URL here.
# Alerts fire when ≥10 errors/minute; cooldown 5 minutes between messages.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx

# ─── Adresses email professionnelles (primeo.ci — boîtes Zoho Mail) ──────────
# Toutes ont une valeur par défaut dans src/config/emails.config.ts ; ne les définir
# que pour surcharger. Boîtes : contact@, admin@, legal@, professionnel@ (le reste = alias).
# Expéditeur des emails transactionnels (doit être un expéditeur validé dans Brevo)
EMAIL_FROM=noreply@primeo.ci
EMAIL_FROM_NAME=Primeo
# Adresse de réponse des emails transactionnels
EMAIL_REPLY_TO=contact@primeo.ci
# Expéditeur des réponses du support (tickets, réponses aux messages de contact)
EMAIL_SUPPORT_FROM=support@primeo.ci
SUPPORT_EMAIL=support@primeo.ci
CONTACT_EMAIL=contact@primeo.ci
RECLAMATION_EMAIL=reclamation@primeo.ci
# Notifications internes (rapports quotidiens, monitoring)
ADMIN_EMAIL=admin@primeo.ci
# Liste CSV facultative de destinataires des rapports (sinon ADMIN_EMAIL)
ADMIN_EMAILS=
LEGAL_EMAIL=legal@primeo.ci
DPO_EMAIL=dpo@primeo.ci
PRESS_EMAIL=presse@primeo.ci
PARTNERSHIP_EMAIL=partenariat@primeo.ci
CAREERS_EMAIL=recrutement@primeo.ci
BILLING_EMAIL=facturation@primeo.ci
SECURITY_EMAIL=securite@primeo.ci
DIRECTION_EMAIL=direction@primeo.ci
PROFESSIONAL_EMAIL=professionnel@primeo.ci
INVESTOR_EMAIL=investisseur@primeo.ci

# Logo officiel affiché dans les emails (PNG Cloudinary, proportions conservées)
EMAIL_LOGO_URL=https://res.cloudinary.com/dlnnxvepd/image/upload/e_trim/c_fit,w_96,h_96,f_png/v1795644228/primeo_logo_z7suoi.png

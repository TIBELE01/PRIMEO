  complained
  opened

  @@map("email_log_status")
}

model EmailLog {
  id           String         @id @default(cuid())
  recipient    String         // adresse email destinataire
  subject      String         // sujet ou identifiant de template
  templateId   Int?           // ID template Brevo (si template)
  status       EmailLogStatus @default(sent)
  errorMessage String?        // message d'erreur si status = failed
  messageId    String?        // ID message Brevo (pour corréler les webhooks)
  bounceCount  Int            @default(0)
  sentAt       DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([recipient])
  @@index([messageId])
  @@map("email_logs")
}

// ── Logs d'envoi SMS (Orange) ──────────────────────────────────────────────────

enum SmsLogStatus {
  pending
  sent
  delivered
  failed
  expired

  @@map("sms_log_status")
}

model SmsLog {
  id          String       @id @default(cuid())
  recipient   String       // numéro destinataire au format +225XXXXXXXXXX
  message     String       @db.Text
  status      SmsLogStatus @default(pending)
  requestId   String?      // ID Orange (dernier segment de resourceURL) pour corréler les webhooks
  errorCode   String?      // code d'erreur Orange ou message d'exception
  isOtp       Boolean      @default(false) // true = SMS OTP critique (fallback email si échec)
  sentAt      DateTime     @default(now())
  deliveredAt DateTime?
  updatedAt   DateTime     @updatedAt

  @@index([recipient])
  @@index([requestId])
  @@map("sms_logs")
}

// ── Feature flags dynamiques ───────────────────────────────────────────────────

model FeatureFlag {
  key         String   @id                    // identifiant unique ex: "show_ai_recommendations"
  enabled     Boolean  @default(false)
  description String?                         // explication lisible pour l'admin
  updatedAt   DateTime @updatedAt
  updatedBy   String?                         // userId de l'admin qui a modifié

  @@map("feature_flags")
}

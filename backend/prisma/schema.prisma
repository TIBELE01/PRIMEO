// ═══════════════════════════════════════════════════════════════════════════
// PRIMEO — Schéma Prisma complet
// Référence : CONTEXTE.md sections 3.1 à 3.12
// Base : PostgreSQL (Supabase) via transaction pooler (DATABASE_URL)
//        + connexion directe pour les migrations (DIRECT_URL)
// ═══════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ÉNUMÉRATIONS
// ─────────────────────────────────────────────────────────────────────────────

// §3.1 — Type de compte utilisateur
enum AccountType {
  client
  professional_hebergement  // résidences, appartements
  professional_hotel        // hôtels
  professional_immobilier
  restaurateur
  admin
}

// §3.1 — Statut du compte utilisateur
enum UserStatus {
  active
  pending
  suspended
  banned
}

// §3.1 — Genre (optionnel)
enum Gender {
  male
  female
  other
}

// §3.2 — Statut de vérification KYC
enum VerificationStatus {
  pending
  approved
  rejected
}

// §3.2 — Type de document KYC
enum DocumentType {
  id_card
  rccm_extract
  tax_id_certificate
  tourist_license
  other
}

// §3.3 — Formule d'abonnement (v2 : Starter / Business / Entreprise)
enum PlanType {
  starter
  business
  entreprise
}

// §3.3 — Statut d'abonnement
enum SubscriptionStatus {
  active
  suspended
  cancelled
}

// §3.4 — Type de propriété (valeurs exactes du spec)
enum PropertyType {
  residence
  hotel
  immobilier_location
  immobilier_terrain
  immobilier_achat
  restaurant
}

// §3.4 — Statut de l'annonce
enum PropertyStatus {
  draft
  pending
  active
  rejected
  suspended
  archived
}

// §3.4 — Type de média (property_media)
enum MediaType {
  photo
  video
  virtual_tour_360
}

// §3.5 — Statut de disponibilité
enum AvailabilityStatus {
  available
  booked
  manually_blocked
}

// §3.6 — Statut de réservation
enum BookingStatus {
  interest_expressed        // immobilier : intérêt sans paiement
  pending_payment
  confirmed
  cancelled_by_client
  cancelled_by_professional
  completed
}

// §3.6 — Option de paiement
enum PaymentOption {
  full_online
  ten_percent_online
  zero_online
}

// §3.7 — Type de transaction
enum TransactionType {
  client_payment
  subscription_payment
  boost_purchase
  refund
  payout_to_professional
  referral_reward
  market_report_purchase
}

// §3.7 — Statut de transaction
enum TransactionStatus {
  initiated
  success
  failed
  refunded
}

// §3.9 — Statut d'un avis
enum ReviewStatus {
  pending_moderation
  published
  hidden
}

// §3.10 — Statut d'un litige
enum DisputeStatus {
  open
  under_review
  resolved_refund_full
  resolved_refund_partial
  resolved_no_refund
  closed
}

// §3.10 — Type de boost
enum BoostType {
  free
  paid
}

// §3.10 — Statut d'un parrainage
enum ReferralStatus {
  pending
  rewarded
  expired
}

// §9.9 — Catégorie de ticket de support
enum TicketCategory {
  technical
  dispute
  information
  complaint
}

// §9.9 — Statut de ticket de support
enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

// §9.9 — Priorité de ticket
enum TicketPriority {
  low
  medium
  high
  urgent
}

// §8.8 — Type de réduction code promo
enum PromoDiscountType {
  percent
  fixed_amount
}

// §7.11 — Rôle d'un co-gérant professionnel
enum GuestRole {
  admin
  editor
  reader
}

// §8.9 — Statut d'une commande de nourriture
enum FoodOrderStatus {
  pending
  confirmed
  preparing
  ready
  delivered
  cancelled
}

// §8.9 — Type de livraison d'une commande
enum FoodOrderDeliveryType {
  dine_in
  takeaway
  delivery
}

// ─────────────────────────────────────────────────────────────────────────────
// §3.1 — TABLE UTILISATEURS
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String?   @unique // null pour les comptes créés via Google OAuth
  firstName    String
  lastName     String
  birthDate    DateTime? @db.Date
  gender       Gender?
  avatarUrl    String?

  // Rôle et statut
  accountType AccountType @default(client)
  extraRoles  Json? // rôles complémentaires (admin sub-roles)
  status      UserStatus  @default(pending)
  deactivatedUntil  DateTime? // null = réactivé ; date = désactivation temporaire jusqu'à cette date

  // Portefeuille et parrainage
  walletBalance Int    @default(0) // FCFA — crédits clients
  referralCode  String @unique @default(cuid())

  // Notifications push et préférences (§11.2–11.4)
  onesignalPlayerId       String?
  notificationPreferences Json?   // { email: bool, push: bool, sms: bool }

  // Note admin interne (§9.4)
  adminNotes String?

  // Email deliverability — bloque les envois futurs si bounce permanent confirmé
  emailBounced Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  professionalProfile   ProfessionalProfile?
  subscription          Subscription?
  properties            Property[]
  clientBookings        Booking[]            @relation("ClientBookings")
  reviewsAuthored       Review[]
  sentMessages          Message[]            @relation("SentMessages")
  receivedMessages      Message[]            @relation("ReceivedMessages")
  notifications         Notification[]
  favorites             Favorite[]
  favoriteLists         FavoriteList[]
  clientDisputes        Dispute[]            @relation("DisputeOpener")
  referralsMade         Referral[]           @relation("ReferrerUser")
  referralReceived      Referral?            @relation("RefereeUser")
  supportTickets        SupportTicket[]      @relation("TicketOwner")
  assignedTickets       SupportTicket[]      @relation("TicketAssignee")
  ticketComments        TicketComment[]
  auditLogs             AuditLog[]
  guestAccesses         ProfessionalGuest[]  @relation("GuestUser")
  promoCodesCreated     PromoCode[]
  transactions          Transaction[]
  clientRatingsGiven    ClientRating[]       @relation("RaterUser")
  clientRatingsReceived ClientRating[]       @relation("RatedUser")
  Boost                 Boost[]
  foodOrders            FoodOrder[]          @relation("ClientFoodOrders")
  pushTokens            PushToken[]

  @@index([accountType, status])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// §3.2 — PROFILS PROFESSIONNELS
// ─────────────────────────────────────────────────────────────────────────────

model ProfessionalProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Informations légales (§3.2)
  businessName   String
  rccm           String?
  taxId          String?
  touristLicense String?

  // Évaluation et description
  ratingStars Decimal? @db.Decimal(3, 2) // 1.00 – 5.00
  description String?

  // Adresse (§3.2)
  street     String?
  city       String?
  postalCode String?
  country    String? @default("CI")
  latitude   Float?
  longitude  Float?

  // Vérification KYC (§3.2)
  verificationStatus VerificationStatus @default(pending)
  verificationNotes  String?
  verifiedAt         DateTime?
  verifiedBy         String? // ID de l'admin

  // Boosts gratuits mensuel (§3.3, §7.7)
  boostsFreeUsedThisMonth Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  documents     ProfessionalDocument[]
  guestAccesses ProfessionalGuest[]

  @@map("professional_profiles")
}

// §3.2 — Documents justificatifs KYC
model ProfessionalDocument {
  id             String              @id @default(cuid())
  profileId      String
  profile        ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type           DocumentType
  url            String // URL Cloudinary
  uploadedAt     DateTime            @default(now())
  verifiedAt     DateTime?
  rejectedReason String?

  @@map("professional_documents")
}

// ─────────────────────────────────────────────────────────────────────────────
// §3.3 — ABONNEMENTS
// ─────────────────────────────────────────────────────────────────────────────

model Subscription {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Formule (§3.3)
  planType        PlanType
  startDate       DateTime           @default(now())
  nextBillingDate DateTime
  endDate         DateTime?
  status          SubscriptionStatus @default(active)

  // Tarification (§3.3 : 0 / 9000 / 24000 FCFA)
  monthlyPrice            Int // FCFA
  includedPropertiesLimit Int // 3 / 15 / illimité (9999)
  commissionRate          Decimal @db.Decimal(5, 2) // 9 / 5 / 0

  // Fonctionnalités JSON (§3.3)
  features Json?

  // Boosts gratuits (§3.3 : 0 / 2 / 10)
  boostsFreeMonthly       Int @default(0)
  boostsFreeUsedThisMonth Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  transactions Transaction[]

  @@map("subscriptions")
}

// ─────────────────────────────────────────────────────────────────────────────
// §3.4 — PROPRIÉTÉS
// ─────────────────────────────────────────────────────────────────────────────

model Property {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  // Type et contenu (§3.4)
  propertyType PropertyType
  title        String
  description  String

  // Caractéristiques (§3.4)
  rooms     Int?
  bedrooms  Int?
  beds      Int?
  bathrooms Int?
  surface   Decimal? @db.Decimal(10, 2) // m²
  capacity  Int? // personnes ou couverts

  // Prix selon le type (§3.4)
  pricePerNight Int? // FCFA — résidences/hôtels
  pricePerMonth Int? // FCFA — immobilier location
  priceSale     Int? // FCFA — immobilier achat

  // Spécifique restaurants (§8.3, §8.4)
  cuisineType  String?
  openingHours Json? // { lun: ["12:00-14:00","19:00-22:00"], ... }

  // Spécifique immobilier — date de disponibilité estimée
  availableFrom DateTime?

  // Localisation (§3.4)
  street    String?
  city      String
  latitude  Float?
  longitude Float?

  // Statut et visibilité (§3.4)
  status         PropertyStatus @default(draft)
  isBoosted      Boolean        @default(false)
  boostExpiresAt DateTime?

  // Compteurs (§3.4)
  viewsCount    Int     @default(0)
  bookingsCount Int     @default(0)
  rating        Decimal @default(0) @db.Decimal(3, 2)
  reviewCount   Int     @default(0)

  // Options et équipements
  amenities      String[]        @default([])
  paymentOptions PaymentOption[] @default([])
  rules          Json? // règlement intérieur

  // Immobilier — champs spécifiques (§3.4)
  floor            Int?      // étage (0 = rez-de-chaussée)
  yearBuilt        Int?      // année de construction
  availabilityDate DateTime? // date de disponibilité (location / vente)
  diagnostics      Json?     // { dpe: true, carrez: true, amiante: false, ... }

  // Hôtel — types de chambres avec tarifs distincts (§3.4)
  roomTypes Json? // [{ label, pricePerNight, capacity, beds, amenities }]

  // Visite virtuelle 3D (§7.3)
  hasVirtualTour Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  media             PropertyMedia[]
  availabilities    Availability[]
  bookings          Booking[]
  reviews           Review[]
  favorites         Favorite[]
  favoriteListItems FavoriteListItem[]
  boosts            Boost[]
  menuItems      RestaurantMenuItem[]
  timeSlots      RestaurantTimeSlot[]
  specialMenus   RestaurantSpecialMenu[]
  promotions     RestaurantPromotion[]
  foodOrders     FoodOrder[]

  @@index([ownerId])
  @@index([status, propertyType])
  @@index([city, latitude, longitude])
  @@map("properties")
}

// §3.4 — Médias d'une propriété (photos, vidéos, 3D)
model PropertyMedia {
  id         String    @id @default(cuid())
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String // URL Cloudinary
  publicId   String? // Cloudinary public_id — requis pour supprimer le média du CDN
  mediaType  MediaType @default(photo)
  isPrimary  Boolean   @default(false)
  sortOrder  Int       @default(0)
  uploadedAt DateTime  @default(now())

  @@index([propertyId])
  @@map("property_media")
}

// ─────────────────────────────────────────────────────────────────────────────
// §3.5 — DISPONIBILITÉS
// ─────────────────────────────────────────────────────────────────────────────

model Availability {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // §3.5 : date, status, time_slot (restaurants), price_override
  date          DateTime           @db.Date
  status        AvailabilityStatus @default(available)
  timeSlot      String? // ex: "12:00-13:30" (restaurants §8.3)
  priceOverride Int? // FCFA — tarif saisonnier

  createdAt DateTime @default(now())

  @@unique([propertyId, date])
  @@index([propertyId, date])
  @@map("availabilities")
}

// ─────────────────────────────────────────────────────────────────────────────
// §3.6 — RÉSERVATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Booking {
  id         String   @id @default(cuid())
  clientId   String
  client     User     @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Restrict)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  // Dates et participants (§3.6)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  guests    Int      @default(1)

  // Montants (§3.6)
  totalAmount         Int // FCFA
  onlinePaidAmount    Int           @default(0) // FCFA — acompte réellement payé online
  paymentOption       PaymentOption
  commissionAmount    Int           @default(0) // FCFA — part Primeo
  remainingCashAmount Int           @default(0) // FCFA — solde à payer en cash

  // Statut (§3.6)
  status             BookingStatus @default(pending_payment)
  specialRequests    String?
  cancellationReason String?
  cancelledBy        String? // "client" | "professional" | "admin"

  // No-show (§8.5 — restaurants)
  isNoShow  Boolean   @default(false)
  noShowAt  DateTime?

  // Facture PDF (générée à la confirmation du paiement, stockée sur Cloudinary)
  invoiceUrl String?

  // Horodatage (§3.6)
  confirmedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  transactions Transaction[]
  messages     Message[]
  review       Review?
  dispute      Dispute?
  clientRating ClientRating?

  @@index([clientId])
  @@index([propertyId, status])
  @@map("bookings")
}

// ─────────────────────────────────────────────────────────────────────────────
// §3.7 — TRANSACTIONS
// ─────────────────────────────────────────────────────────────────────────────

model Transaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Type et montants (§3.7)
  type      TransactionType
  amount    Int // FCFA
  currency  String          @default("XOF")
  fee       Int             @default(0) // FCFA
  netAmount Int // FCFA — amount - fee

  // Statut (§3.7)
  status TransactionStatus @default(initiated)

  // Références (§3.7)
  bookingId      String?
  booking        Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  // Genius Pay (§3.7)
  geniusPayTransactionId String?
  checkoutUrl            String?
  webhookReceived        Boolean @default(false)
  webhookPayload         Json?

  // Notes libres
  notes String?

  // Horodatage (§3.7)
  initiatedAt DateTime  @default(now())
  completedAt DateTime?

  @@index([userId])
  @@index([bookingId])
  @@index([geniusPayTransactionId])
  @@map("transactions")
}

// ─────────────────────────────────────────────────────────────────────────────
// §3.8 — MESSAGES
// ─────────────────────────────────────────────────────────────────────────────

model Message {
  id String @id @default(cuid())

  // Contexte : réservation OU litige (§3.8 — les deux optionnels)
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  disputeId String?
  dispute   Dispute? @relation(fields: [disputeId], references: [id], onDelete: SetNull)

  // Participants (§3.8)
  senderId   String
  sender     User   @relation("SentMessages", fields: [senderId], references: [id], onDelete: Restrict)
  receiverId String
  receiver   User   @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Restrict)

  content String
  sentAt  DateTime @default(now())
  isRead  Boolean  @default(false)

  @@index([bookingId, sentAt])
  @@index([disputeId])
  @@map("messages")
}

// ─────────────────────────────────────────────────────────────────────────────
// §3.9 — AVIS
// ─────────────────────────────────────────────────────────────────────────────

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  // Notes détaillées (§3.9 — 1 à 5)
  rating              Int // note globale
  cleanlinessRating   Int?
  communicationRating Int?
  accuracyRating      Int?
  locationRating      Int?
  valueRating         Int?

  // Critères spécifiques restaurants
  cuisineRating   Int? // restaurant uniquement
  serviceRating   Int? // restaurant uniquement
  ambianceRating  Int? // restaurant uniquement

  // Contenu (§3.9)
  comment                  String?
  publishedAt              DateTime?
  responseFromProfessional String?

  // Modération (§3.9)
  status ReviewStatus @default(pending_moderation)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  media ReviewMedia[]

  @@index([propertyId])
  @@map("reviews")
}

// §3.9 — Médias joints aux avis
model ReviewMedia {
  id         String   @id @default(cuid())
  reviewId   String
  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  url        String // URL Cloudinary
  uploadedAt DateTime @default(now())

  @@map("review_media")
}

// §6.13 — Évaluation réciproque (client noté par le professionnel)
model ClientRating {
  id          String  @id @default(cuid())
  bookingId   String  @unique
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  ratedUserId String
  ratedUser   User    @relation("RatedUser", fields: [ratedUserId], references: [id], onDelete: Restrict)
  raterUserId String
  raterUser   User    @relation("RaterUser", fields: [raterUserId], references: [id], onDelete: Restrict)

  // Critères (§6.13)
  respectRating       Int // 1–5
  communicationRating Int
  punctualityRating   Int
  rulesRating         Int
  overallRating       Int

  comment  String?
  isPublic Boolean @default(true)
  isHidden   Boolean @default(false) // masqué par admin après signalement
  isReported Boolean @default(false) // signalé par le client comme injuste
  reportReason String? // motif du signalement

  createdAt DateTime @default(now())

  @@map("client_ratings")
}

// ─────────────────────────────────────────────────────────────────────────────
// §3.10 — BOOSTS
// ─────────────────────────────────────────────────────────────────────────────

model Boost {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  // §3.10 : start_date, end_date, amount, type
  startDate DateTime
  endDate   DateTime
  amount    Int       @default(0) // FCFA — 0 pour les boosts gratuits
  type      BoostType

  createdAt DateTime @default(now())

  @@index([propertyId])
  @@map("boosts")
}

// ─────────────────────────────────────────────────────────────────────────────
// §3.10 — PARRAINAGES
// ─────────────────────────────────────────────────────────────────────────────

model Referral {
  id String @id @default(cuid())

  // §3.10 : code, referrer_id, referee_id, inscription_date, reward_date
  referralCode String  @unique // code utilisé pour l'inscription
  referrerId   String
  referrer     User    @relation("ReferrerUser", fields: [referrerId], references: [id], onDelete: Restrict)
  refereeId    String? @unique
  referee      User?   @relation("RefereeUser", fields: [refereeId], references: [id], onDelete: SetNull)

  status          ReferralStatus @default(pending)
  inscriptionDate DateTime? // date d'inscription du filleul
  rewardDate      DateTime? // date de versement de la récompense
  rewardAmount    Int            @default(2000) // FCFA (§5.14)

  createdAt DateTime @default(now())

  @@index([referrerId])
  @@map("referrals")
}

// ─────────────────────────────────────────────────────────────────────────────
// §3.10 — LITIGES
// ─────────────────────────────────────────────────────────────────────────────

model Dispute {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  openedBy  String
  opener    User    @relation("DisputeOpener", fields: [openedBy], references: [id], onDelete: Restrict)

  // §3.10 : reason, status, resolution
  reason       String
  description  String?
  status       DisputeStatus @default(open)
  resolution   String?
  refundAmount Int? // FCFA — montant remboursé (partiel ou total)
  adminNotes   String?

  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relations
  messages Message[]

  @@map("disputes")
}

// ─────────────────────────────────────────────────────────────────────────────
// §3.10 — JOURNAUX D'AUDIT
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // §3.10 : action, description, ip_address, timestamp
  action      String // ex: "booking.cancel", "kyc.approve", "user.ban"
  description String?
  ipAddress   String?
  targetType  String? // ex: "booking", "user", "property"
  targetId    String? // ID de la cible
  metadata    Json?

  createdAt DateTime @default(now()) // = timestamp

  @@index([userId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

// Archive des logs d'audit (> 1 an) — alimentée par archive_old_audit_logs().
// Immuable (trigger DB) ; pas de FK users : survit à la suppression des comptes.
model AuditLogArchive {
  id          String  @id
  userId      String?
  action      String
  description String?
  ipAddress   String?
  targetType  String?
  targetId    String?
  metadata    Json?

  createdAt  DateTime
  archivedAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@map("audit_logs_archive")
}

// Événements analytics anonymisés (mobile + vitrine) — aucune donnée personnelle :
// pas d'userId ni d'IP, seulement un identifiant de session aléatoire côté client.
model AppEvent {
  id        String  @id @default(cuid())
  name      String // ex : signup, login, search, property_view, booking_created, payment_success
  platform  String? // mobile | web
  role      String? // client | professional | anonymous
  sessionId String?
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@map("app_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// §5.13 / §6.9 — FAVORIS ET LISTES
// ─────────────────────────────────────────────────────────────────────────────

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@map("favorites")
}


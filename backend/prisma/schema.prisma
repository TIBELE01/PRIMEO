model SupportTicket {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("TicketOwner", fields: [userId], references: [id], onDelete: Restrict)

  // §9.9 : catégorie, sujet, description, statut, priorité
  category    TicketCategory
  subject     String
  description String
  status      TicketStatus   @default(open)
  priority    TicketPriority @default(medium)

  assignedTo  String?
  assignee    User?    @relation("TicketAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  attachments String[] @default([]) // Cloudinary URLs of uploaded files

  resolvedAt DateTime?
  closedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  comments TicketComment[]

  @@index([userId])
  @@index([status, priority])
  @@map("support_tickets")
}

